[*.{cs}]

# Indentation
indent_style = space
indent_size = 4

# Braces
csharp_brace_style = next_line_expl_type = true
csharp_brace_style = next_line_expl_anonymous = true
csharp_brace_style = next_line_expl_function = false
csharp_brace_style = end_of_line_expl_type = false
csharp_brace_style = end_of_line_expl_anonymous = false
csharp_brace_style = end_of_line_expl_function = false
csharp_brace_style = outdents_on_line = true

# Expression-level
csharp_wrap_before_binop = false
csharp_wrap_after_binop = true
csharp_indent_call_args = true
csharp_indent_expr_body = true
csharp_indent_parameter_multiline = true
csharp_indent_params = true

# Pattern matching
csharp_prefer_pattern_matching = true

# Var usage
csharp_prefer_var_elsewhere = true
csharp_prefer_built_in_type_alias = true
csharp_prefer_inferred_anonymous_type_member_names = true

# Expression-bodied members
csharp_style_expression_bodied_methods = when_possible
csharp_style_expression_bodied_properties = when_possible
csharp_style_expression_bodied_lambdas = when_possible

# Null-coalescing
csharp_style_null_propagation = when_possible

# Using directives
csharp_sort_system_directives_first = true

# Braces for single-line statements
csharp_new_line_before_open_block_when_multistatement = true
